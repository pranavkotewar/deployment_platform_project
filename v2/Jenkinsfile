pipeline {
    agent any
    options {
        disableConcurrentBuilds()
    }
    parameters {
        string(name: 'REPO_URL', defaultValue: 'https://github.com/pranavkotewar/sample-static-app', description: 'GitHub repository URL')
        string(name: 'APP_PATH', defaultValue: '.', description: 'App folder inside the repo (. for root)')
        string(name: 'TEMPLATE', defaultValue: '', description: 'static, flask or node. Used only if the app has no Dockerfile')
        string(name: 'APP_NAME', defaultValue: 'demo-app', description: 'Unique app name (lowercase letters, digits, hyphen)')
    }
    environment {
        VM2_HOST = 'projectvm2@my-app'
        WORK = "deployforge/work/${params.APP_NAME}"
    }
    stages {
        stage('Check Parameters') {
            steps {
                script {
                    if (!(params.REPO_URL ==~ '^https://github\\.com/[\\w.-]+/[\\w.-]+?(\\.git)?/?$')) { error('Invalid REPO_URL') }
                    if (!(params.APP_PATH ==~ '^[A-Za-z0-9._/-]+$') || params.APP_PATH.contains('..') || params.APP_PATH.startsWith('/')) { error('Invalid APP_PATH') }
                    if (!(params.APP_NAME ==~ '^[a-z0-9][a-z0-9-]{0,40}$')) { error('Invalid APP_NAME') }
                    if (!(params.TEMPLATE in ['', 'static', 'flask', 'node'])) { error('Invalid TEMPLATE') }
                }
            }
        }
        stage('Copy Scripts to VM2') {
            steps {
                sh '''
                ssh -n -o StrictHostKeyChecking=accept-new "$VM2_HOST" "mkdir -p deployforge && rm -rf deployforge/scripts deployforge/dockerfile-templates"
                scp -rq v2/scripts v2/dockerfile-templates "$VM2_HOST":deployforge/
                '''
            }
        }
        stage('Clone Repository') {
            steps {
                sh '''
                ssh -n "$VM2_HOST" "rm -rf '$WORK' && mkdir -p '$WORK' && git clone --depth 1 -q '$REPO_URL' '$WORK/repo'"
                '''
            }
        }
        stage('Validate') {
            steps {
                sh '''
                ssh -n "$VM2_HOST" "bash deployforge/scripts/validate.sh '$WORK/repo' '$APP_PATH' '$TEMPLATE'"
                '''
            }
        }
        stage('Resolve Dockerfile') {
            steps {
                sh '''
                ssh -n "$VM2_HOST" "bash deployforge/scripts/resolve_dockerfile.sh '$WORK/repo' '$APP_PATH' '$TEMPLATE' deployforge/dockerfile-templates" > resolve.out || { cat resolve.out; exit 1; }
                cat resolve.out
                '''
                script {
                    env.CPORT = sh(returnStdout: true, script: "grep '^CONTAINER_PORT=' resolve.out | cut -d= -f2").trim()
                }
            }
        }
        stage('Build Image') {
            steps {
                sh '''
                ssh -n "$VM2_HOST" "cd '$WORK/repo/$APP_PATH' && docker build --no-cache -t '$APP_NAME:$BUILD_NUMBER' -t '$APP_NAME:latest' ."
                '''
            }
        }
        stage('Assign Port') {
            steps {
                sh '''
                ssh -n "$VM2_HOST" "bash deployforge/scripts/assign_port.sh assign '$APP_NAME' '$CPORT'" > port.out || { cat port.out; exit 1; }
                cat port.out
                '''
                script {
                    env.HPORT = sh(returnStdout: true, script: "grep '^PORT=' port.out | tail -1 | cut -d= -f2").trim()
                }
            }
        }
        stage('Run Container') {
            steps {
                sh '''
                ssh -n "$VM2_HOST" "docker rm -f '$APP_NAME' >/dev/null 2>&1; docker run -d --restart unless-stopped --name '$APP_NAME' -p '$HPORT:$CPORT' '$APP_NAME:latest'"
                '''
            }
        }
        stage('Health Check') {
            steps {
                sh '''
                ssh -n "$VM2_HOST" "bash deployforge/scripts/health_check.sh wait '$APP_NAME' '$HPORT'"
                '''
            }
        }
    }
    post {
        always {
            sh '''
            ssh -n "$VM2_HOST" "bash deployforge/scripts/cleanup.sh '$APP_NAME' '$WORK'" || true
            rm -f resolve.out port.out
            '''
        }
        success {
            echo "DEPLOY SUCCESS: ${params.APP_NAME} on VM2 port ${env.HPORT} (container port ${env.CPORT})"
        }
        failure {
            echo "DEPLOY FAILED: check the failed stage above."
        }
    }
}
